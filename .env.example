# ============================================================================
# SVKM's NMIMS Global University, Dhule — AI voice assistant configuration
# Copy to .env and fill in. EVERY provider has a zero-key local fallback so the
# system boots and runs end-to-end without any credentials (see docs/ARCHITECTURE.md).
# ============================================================================

# ---- Core -----------------------------------------------------------------
ENVIRONMENT=development                 # development | staging | production
LOG_LEVEL=INFO
# Public base URL of this service. Telephony websockets MUST be wss:// and
# reachable from the provider (use ngrok/cloudflared in dev).
PUBLIC_BASE_URL=http://localhost:8000
# Secret used to sign/verify webhook callbacks. Generate with: openssl rand -hex 32
APP_SECRET=change-me-in-production

# ---- Database -------------------------------------------------------------
# SQLite (default, zero setup) — or Postgres for production:
DATABASE_URL=sqlite:///data/runtime/nims_voice.db
# Any postgresql:// URL works: app/db.py normalises it to the asyncpg driver,
# so `asyncpg` (in requirements.txt) is the package that must be installed —
# psycopg is not used.
# DATABASE_URL=postgresql://nims:nims@localhost:5432/nims_voice
# Set true with VECTOR_STORE=pgvector to keep embeddings in Postgres too
# (PgVectorStore runs CREATE EXTENSION IF NOT EXISTS vector itself).
PGVECTOR_ENABLED=false

# ---- Telephony ------------------------------------------------------------
# twilio | exotel | plivo | simulator
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# University helpline (toll-free or local). Used for outbound SMS follow-ups.
TWILIO_HELLINE_NUMBER=+15551234567
# Where a call goes when the AI escalates. Comma separated E.164 numbers or a Twilio queue name.
ESCALATION_AGENTS=+911412345678,+919876500000
ESCALATION_QUEUE_NAME=nmims-dhule-admissions-queue
ESCALATION_MAX_WAIT_SECONDS=300
# Hold music URL (must be publicly reachable, <MP3/WAV>)
HOLD_MUSIC_URL=https://api.twilio.com/cowbell.mp3
# Read a summary of the AI conversation to the agent before bridging (whisper page)
ESCALATION_WHISPER_CONTEXT=true

# ---- Language Identification ----------------------------------------------
# azure | google | deepgram | local
LID_PROVIDER=local
# BCP-47 codes offered to callers. The greeting codes are spoken in the opening
# prompt, in order, so keep them to the two or three the campus actually hears.
# Dhule (Maharashtra, Khandesh): Marathi, Hindi and English, with Gujarati close
# behind. The remaining codes stay recognised — if a caller names one we switch
# to it — but they are not announced.
SUPPORTED_LANGUAGES=en-IN,hi-IN,mr-IN,gu-IN,ta-IN,bn-IN,te-IN,kn-IN,ml-IN,pa-IN,ur-IN,raj-IN
GREETING_LANGUAGES=en-IN,hi-IN,mr-IN
LID_CONFIDENCE_THRESHOLD=0.62
# Spoken-only language selection is the product requirement; DTMF is a LAST RESORT
# for callers who cannot be understood. Set false to disable entirely.
ALLOW_DTMF_FALLBACK=true

# ---- Speech-to-Text -------------------------------------------------------
# deepgram | assemblyai | google | azure | whisper | client | none
ASR_PROVIDER=client
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
OPENAI_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=gpt-4o-mini-transcribe
ASR_INTERIM_RESULTS=true
# Endpoint silence (ms) before an utterance is considered complete
ASR_ENDPOINT_SILENCE_MS=650

# ---- Text-to-Speech -------------------------------------------------------
# google | azure | elevenlabs | local | client | none
TTS_PROVIDER=client
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_SPEAKING_RATE=1.0
TTS_SAMPLE_RATE=8000

# ---- LLM / reasoning ------------------------------------------------------
# anthropic | openai | local
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.2
# Streaming token generation → first audio packet as soon as the first sentence is ready
LLM_STREAMING=true
# If the model cannot ground an answer it must escalate rather than guess
ANSWER_CONFIDENCE_THRESHOLD=0.55

# ---- Embeddings / RAG -----------------------------------------------------
# openai | cohere | local
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
COHERE_API_KEY=
# local | pgvector | qdrant
VECTOR_STORE=local
VECTOR_DIMENSIONS=768
QDRANT_URL=http://localhost:6333
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.22
RAG_CITATIONS_REQUIRED=true

# ---- Knowledge base -------------------------------------------------------
KB_SEED_DIR=data/kb
KB_AUTO_INGEST=true
# Admission cycle the assistant prefers when the KB holds several years.
# Must match the academic_year on the seeded records.
KB_ACADEMIC_YEAR=2026-27
# Optional Google Sheet sync (publish sheet as CSV). Non-technical staff edit the
# sheet; a scheduled job pulls it in. Leave empty to disable.
KB_GOOGLE_SHEET_CSV_URL=
KB_SYNC_INTERVAL_MINUTES=60
# Records older than this many days are flagged stale in the admin dashboard
KB_STALENESS_DAYS=180

# ---- Guardrails / compliance ----------------------------------------------
# Announce recording + AI at the start of the call (TRAI / DPDP Act 2023)
RECORDING_CONSENT_ANNOUNCE=true
CALL_RECORDING_ENABLED=false
ALLOW_CALL_RECORDING_STORAGE=false
# PII redaction before anything is persisted
REDACT_PII=true
MAX_CALL_MINUTES=15
SILENCE_MAX_REPROMPTS=2

# ---- Follow-up channel (SMS / WhatsApp / email the details) ----------------
FOLLOWUP_SMS_ENABLED=false
FOLLOWUP_WHATSAPP_ENABLED=false
FOLLOWUP_EMAIL_ENABLED=false
SENDGRID_API_KEY=
# Sender identity for outbound follow-up email. The university website publishes
# NO email address, so this must be an operator-owned verified sender - it is
# never spoken to a caller nor printed as a university contact.
FOLLOWUP_FROM_EMAIL=admissions@svkmnmimsgu.ac.in

# ---- Admin dashboard ------------------------------------------------------
# Simple shared-password auth for the staff dashboard. In production put this
# behind the university SSO / a reverse proxy with mTLS.
ADMIN_USERNAME=nmims-admin
ADMIN_PASSWORD=change-me
ADMIN_AUTH_ENABLED=true

# ---- Observability --------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=true
