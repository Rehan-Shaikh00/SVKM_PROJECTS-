# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://svkm_user:svkm_password@localhost:5432/svkm_voice_assistant
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# Redis Cache
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# Azure Speech Services
# =============================================================================
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_ENDPOINT=https://centralindia.api.cognitive.microsoft.com/

# =============================================================================
# Azure OpenAI (for embeddings)
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# Anthropic Claude API
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4
ANTHROPIC_MAX_TOKENS=4096

# =============================================================================
# Azure Blob Storage
# =============================================================================
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_STORAGE_CONTAINER_RAW_SOURCES=raw-sources
AZURE_STORAGE_CONTAINER_RECORDINGS=call-recordings

# =============================================================================
# Azure Key Vault (optional - for production)
# =============================================================================
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_KEY_VAULT_ENABLED=false

# =============================================================================
# Exotel Telephony (disabled by default)
# =============================================================================
EXOTEL_ENABLED=false
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_APP_ID=your_exotel_app_id
EXOTEL_STATUS_CALLBACK_URL=https://yourdomain.com/webhooks/exotel/status
EXOTEL_RECORDING_CALLBACK_URL=https://yourdomain.com/webhooks/exotel/recording

# =============================================================================
# Provider Mode (fake for development without credentials)
# =============================================================================
# Options: real, fake
PROVIDERS_MODE=real

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=SVKM NMIMS Voice Assistant
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# API Service
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=4

# =============================================================================
# Realtime Gateway
# =============================================================================
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8001
REALTIME_MAX_CONNECTIONS=1000
REALTIME_SESSION_TIMEOUT_SECONDS=1800

# =============================================================================
# Web UI
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:8001
NEXT_PUBLIC_APP_NAME=SVKM NMIMS Voice Assistant

# =============================================================================
# Authentication (Entra ID / Azure AD)
# =============================================================================
AUTH_ENABLED=false
AZURE_AD_TENANT_ID=your_tenant_id
AZURE_AD_CLIENT_ID=your_client_id
AZURE_AD_CLIENT_SECRET=your_client_secret

# =============================================================================
# Privacy & Retention
# =============================================================================
RECORDINGS_ENABLED=false
TRANSCRIPT_RETENTION_DAYS=90
ANALYTICS_RETENTION_DAYS=365
REQUIRE_CONSENT=true

# =============================================================================
# Knowledge Base
# =============================================================================
EMBEDDING_BATCH_SIZE=100
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=10
CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# Conversation
# =============================================================================
LANGUAGE_DETECTION_TIMEOUT_SECONDS=5
ASR_INTERIM_RESULTS=true
TTS_VOICE_EN_IN=en-IN-NeerjaNeural
TTS_VOICE_HI_IN=hi-IN-SwaraNeural
TTS_VOICE_MR_IN=mr-IN-AarohiNeural
MAX_TURN_DURATION_SECONDS=300

# =============================================================================
# Observability
# =============================================================================
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AZURE_MONITOR_CONNECTION_STRING=your_app_insights_connection_string

# =============================================================================
# CORS (for development)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
